project:
  type: website

from: markdown+hard_line_breaks

website:
  title: "Wiki"
  site-url: "https://comarandr.github.io/wiki/"
  navbar:
    left:
      - href: "https://comarandr.github.io/"
        text: "Home"
      - href: "http://comarandr.github.io/wiki/linguaggi/indexLing.html"
        text: "Linguaggi"
      - href: "http://comarandr.github.io/wiki/universita/indexUni.html"
        text: "Università"
      - href: "http://comarandr.github.io/wiki/personali/indexPers.html"
        text: "Personali"
      - href: "http://comarandr.github.io/wiki/indexMin.html"
        text: "Minimali"
    right:
      - href: about.qmd
        text: About

format:
  html:
    theme:
      - cosmo
      - brand
    css: styles.css
    toc: true
    toc-depth: 4

execute: 
  cache: true
  echo: false
  freeze: auto
  
  

